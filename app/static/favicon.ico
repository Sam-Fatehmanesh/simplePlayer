<body>

<div class="container">
    <div class="row" style="margin-top: 20%">
        <h2>Ricketts Hovse</h2>
            <div class="slider">
                <div><img src="/static/ricketts/slider/slider_0.JPG"></div>
                <div><img src="/static/ricketts/slider/slider_2.JPG"></div>
